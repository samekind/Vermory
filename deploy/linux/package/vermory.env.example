# Copy to /etc/vermory/vermory.env, replace every deployment-specific value,
# set ownership to root:root and mode to 0600, then complete database migration
# and runtime-role grants before enabling vermory.service.
VERMORY_DATABASE_URL=postgresql://vermory_runtime:REPLACE_ME@127.0.0.1:5432/vermory?sslmode=require
VERMORY_LISTEN=127.0.0.1:8788
VERMORY_PROVIDER=mock
